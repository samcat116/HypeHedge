{
  "name": "hypehedge",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply hypehedge --local",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/cloudflare src/database.ts src/accounting.ts src/exchange.ts tests/cloudflare",
    "lint:fix": "biome check --write src/cloudflare src/database.ts src/accounting.ts src/exchange.ts tests/cloudflare",
    "register": "node scripts/register.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261010.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
